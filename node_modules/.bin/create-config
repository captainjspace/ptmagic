#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/joshlandman/node_modules/.pnpm/@eslint+create-config@1.11.0/node_modules/@eslint/create-config/node_modules:/Users/joshlandman/node_modules/.pnpm/@eslint+create-config@1.11.0/node_modules:/Users/joshlandman/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/joshlandman/node_modules/.pnpm/@eslint+create-config@1.11.0/node_modules/@eslint/create-config/node_modules:/Users/joshlandman/node_modules/.pnpm/@eslint+create-config@1.11.0/node_modules:/Users/joshlandman/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../node_modules/.pnpm/@eslint+create-config@1.11.0/node_modules/@eslint/create-config/bin/create-config.js" "$@"
else
  exec node  "$basedir/../../../../node_modules/.pnpm/@eslint+create-config@1.11.0/node_modules/@eslint/create-config/bin/create-config.js" "$@"
fi
