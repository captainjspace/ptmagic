{
  "name": "@ptcalc/utils",
  "version": "1.0.0",
  "description": "detailed breakdown of PT calcs",
  "scripts": {
    "lint": "eslint src/*",
    "dev": "ts-node src/index.ts",
    "calc": "node dist/index.js ",
    "dev-thresh": "node dist/costThreshold",
    "check": "tsc --noEmit",
    "build": "pnpm store prune; pnpm exec tsc",
    "minify": "swc dist/*.js -d dist --strip-leading-paths",
    "build:fullswc": "swc src -d bin --copy-files --strip-leading-paths",
    "buildMini": "swc src -o ptcalc.js --strip-leading-paths"
  },
  "keywords": ["GCP","GSU","Provisioned Throughput", "Calculator"],
  "author": "joshlandman@google.com",
  "license": "MIT",
  "devDependencies": {
    "@eslint/create-config": "^2.0.0",
    "@eslint/json": "^1.2.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "paths": {
    "src/*": [
      "./src/*.ts",
      "./src/*"
    ]
  },
  "bit": {
    "env": {},
    "componentsDefaultDirectory": "components/{name}",
    "packageManager": "gpkg pnpm"
  }
}

