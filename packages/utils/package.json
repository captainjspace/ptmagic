{
  "name": "@ptcalc/utils",
  "version": "1.0.0",
  "description": "detailed breakdown of PT calcs",
  "scripts": {
    "lint": "eslint src/*",
    "dev": "ts-node src/index.ts",
    "calc": "node src/index.js ",
    "ptrep": "node src/costThreshold",
    "build": "tsc -b"
  },
  "keywords": [],
  "author": "joshlandman@google.com",
  "license": "MIT",
  "devDependencies": {
    "@eslint/create-config": "^2.0.0",
    "@eslint/json": "^1.2.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "paths": {
    "src/*": [
      "./src/*.ts",
      "./src/*"
    ]
  },
  "bit": {
    "env": {},
    "componentsDefaultDirectory": "components/{name}",
    "packageManager": "gpkg pnpm"
  }
