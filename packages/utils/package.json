{
  "name": "@ptcalc/utils",
  "version": "1.0.0",
  "description": "detailed breakdown of PT calcs",
  "scripts": {
    "lint": "eslint . --fix",
    "dev": "pnpm exec tsx src/index.ts",
    "calc": "node dist/index.js ",
    "dev-thresh": "node src/out_of_play/costThreshold.mjs",
    "check": "tsc --noEmit",
    "build": "rm -f tsconfig.tsbuildinfo && tsc",
    "build:mini": "swc src -o ptcalc.js --strip-leading-paths"
  },
  "keywords": [
    "GCP",
    "GSU",
    "Provisioned Throughput",
    "Calculator"
  ],
  "author": "joshlandman@google.com",
  "license": "MIT",
  "devDependencies": {
    "@eslint/create-config": "^2.0.0",
    "@eslint/json": "^2.0.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.40",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "swc": "^1.0.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "paths": {
    "src/*": [
      "./src/*.ts",
      "./src/*"
    ]
  },
  "bit": {
    "env": {},
    "componentsDefaultDirectory": "components/{name}",
    "packageManager": "gpkg pnpm"
  }
}
