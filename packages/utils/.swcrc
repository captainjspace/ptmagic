{
  "$schema": "https://swc.rs/schema.json",
  "jsc": {
    "parser": {
      "syntax": "ecmascript",
      "tsx": false,
      "decorators": false,
      "dynamicImport": true,
      "importAttributes": true
    },
    "transform": null,
    "target": "esnext", 
    "experimental": {
      "keepImportAssertions": true
    },
    "loose": false,
    "externalHelpers": false,
    "keepClassNames": true
  },
  "module": {
    "type": "es6",
    "strict": true,
    "strictMode": true,
    "lazy": false,
    "noInterop": false
  },
  "minify": true
}
