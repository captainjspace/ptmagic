{
  "$schema": "https://biomejs.dev",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth":2,
    "lineWidth": 80
  },
  {
  "files": {
    "ignore": ["**/dist/**", "**/.next/**", "**/node_modules/**"]
  }
}

}

