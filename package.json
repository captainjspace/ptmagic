{
  "name": "@ptcalc",
  "version": "1.0.0",
  "description": "detailed breakdown of PT calcs",
  "type": "module",
  "scripts": {
    "lint": "pnpm biome lint .",
    "format": "pnpm biome format .",
    "check": "pnpm biome check .",
    "check:write": "pnpm biome check --write .",
    "build:calc": "pnpm --filter @ptcalc/utils run build",
    "build:web": "pnpm --filter @ptcalc/pt-magic run build",
    "build": "pnpm run build:calc && pnpm run build:web",
    "clean": "pnpm -r exec -- rm -rf dist *.tsbuildinfo && rm -rf node_modules dist *.tsbuildinfo",
    "ci": "pnpm run clean && pnpm install && pnpm run build",
    "launch": "pnpm --filter @ptcalc/utils run calc && pnpm --filter @ptcalc/pt-magic run preview",
    "dev": " pnpm --filter @ptcalc/pt-magic run dev"
  },
  "keywords": [],
  "author": "joshgcp@rollingblackoutband,com",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@pnpm/plugin-esm-node-path": "^0.1.2",
    "@tsconfig/create-react-app": "^2.0.11",
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/recommended": "^1.0.13",
    "@tsconfig/vite-react": "^8.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "biome": "^0.3.3",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "oxlint": "^1.73.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "@types/node": "^26.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.1.4"
  }
}
